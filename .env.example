# ===========================
# 🔑 Exchange API Keys
# ===========================

# Binance (Real Account)
BINANCE_API_KEY="your_real_binance_api_key"
BINANCE_API_SECRET="your_real_binance_api_secret"

# Gate.io (Real Account)
GATEIO_API_KEY="your_real_gateio_api_key"
GATEIO_API_SECRET="your_real_gateio_api_secret"

# Weex.io (Real Account)
WEEX_API_KEY="your_real_weex_api_key"
WEEX_API_SECRET="your_real_weex_api_secret"

# ===========================
# 🌍 API Endpoints
# ===========================

# Real Endpoints
BINANCE_API_URL="https://api.binance.com"
GATEIO_API_URL="https://api.gateio.ws/api/v4"
WEEX_API_URL="https://api.weex.com"

# Demo/Testnet Endpoints (only if user selects Demo Mode)
BINANCE_TESTNET_URL="https://testnet.binance.vision"
GATEIO_TESTNET_URL="https://fx-api-testnet.gateio.ws/api/v4"
WEEX_TESTNET_URL="https://testnet-api.weex.com"

# ===========================
# ⚙️ Environment Control
# ===========================

# Default mode = REAL
# Options: REAL or DEMO
EXCHANGE_MODE="REAL"

# ===========================
# 🌐 App Config
# ===========================

# App URL (Cloud Run / VPS)
APP_URL="https://your-app-url"

# Webhook Port
PORT=80



# PORT: The port configuration for the Web Server.
# Defaults to 3000 in AI Studio, but MUST be set to 80 when deploying on a VPS for standard public webhooks.
PORT=80

